    "dev": "vite build --watch"
  },
  "dependencies": {
    "core": "portal:../core"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  }
}
