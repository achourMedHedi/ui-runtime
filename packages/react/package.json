{
  "name": "ur-react",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
